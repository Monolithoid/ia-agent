// Bitterbot — configuration 100% locale
// Copier ce fichier vers : /opt/ia/bitterbot/config/bitterbot.json
// Générer le gateway token : openssl rand -hex 32
//
// Composants désactivés intentionnellement :
//   - Tous les canaux messaging (WhatsApp, Telegram, Discord, Signal, Slack)
//   - Discovery P2P large zone (libp2p / Gossipsub)
//   - Onramp Stripe (aucune clé cloud configurée)
//
// Composants actifs :
//   - Inférence 100% locale via Ollama (http://ollama:11434)
//   - Dream Engine (consolidation mémoire toutes les 2h)
//   - Ingestion documents (workspace, OneDrive, Google Drive en lecture seule)
//   - Gateway WebSocket + API OpenAI-compatible sur le port 19001

{
  // ----------------------------------------------------------------
  // AGENT
  // ----------------------------------------------------------------
  agents: {
    defaults: {
      // Répertoire de travail — contient aussi les sous-dossiers onedrive/ et gdrive/
      workspace: "/home/node/.bitterbot/workspace",
      // model.primary = référence canonique provider:nom
      model: {
        primary: "ollama:qwen2.5:7b",
      },
    },
  },

  // ----------------------------------------------------------------
  // FOURNISSEURS LLM — Ollama local uniquement
  // ----------------------------------------------------------------
  models: {
    providers: {
      ollama: {
        // Résolution Docker interne (service "ollama" sur le réseau bitterbot-net)
        baseUrl: "http://ollama:11434",
        apiKey: "ollama-local",
        // API native Ollama : streaming + tool calling simultanés
        api: "ollama",
        // Liste des modèles exposés par ce provider (obligatoire depuis 85b5095)
        models: [
          { id: "qwen2.5:7b" },
        ],
      },
    },
  },

  // ----------------------------------------------------------------
  // CANAUX MESSAGING — tous désactivés par omission
  // Le schéma n'accepte plus "enabled" à la racine d'un channel ;
  // la désactivation se fait au niveau account (accounts[].enabled).
  // Ne pas définir la section = aucun canal actif.
  // ----------------------------------------------------------------

  // ----------------------------------------------------------------
  // P2P / DISCOVERY — large zone désactivée
  // Coupe libp2p / Gossipsub sur le WAN. Le nœud reste joignable
  // localement mais n'annonce rien sur le réseau public.
  // ----------------------------------------------------------------
  discovery: {
    wideArea: {
      enabled: false,
    },
  },

  // ----------------------------------------------------------------
  // DREAM ENGINE — actif (pipeline mémoire nocturne)
  // Modes : Replay, Mutation, Extrapolation, Compression,
  //         Simulation, Exploration, Research
  // Cycle : toutes les 2h (déclenchement émotionnel si dopamine > 0.7)
  // DB SQLite : /home/node/.bitterbot/memory/memory.db (persisté dans le volume)
  // ----------------------------------------------------------------
  // Pas de section à désactiver — le Dream Engine tourne par défaut.
  // Pour forcer une consolidation manuelle :
  //   docker exec bitterbot-gateway node bitterbot.mjs memory consolidate

  // ----------------------------------------------------------------
  // GATEWAY
  // ----------------------------------------------------------------
  gateway: {
    auth: {
      // Doit correspondre exactement à BITTERBOT_GATEWAY_TOKEN dans docker-compose.yml
      token: "CHANGE_THIS_BITTERBOT_TOKEN",
    },
  },
}
