# Service systemd « utilisateur » du drone statique, pour un PC Ubuntu de
# bureau (PC portable…) : il tourne dans la session de l'utilisateur et
# accède donc au son PipeWire/PulseAudio (micro et haut-parleur choisis dans
# Paramètres > Son). Voir pc-portable-ubuntu.md. Installation :
#   mkdir -p ~/.config/systemd/user
#   cp static-drone-user.service ~/.config/systemd/user/static-drone.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now static-drone
#   sudo loginctl enable-linger $USER     # démarre sans ouvrir de session
#   journalctl --user -u static-drone -f
#
# %h = dossier personnel. Adapter le chemin si le dépôt n'est pas dans ~/ia-agent.
# Le fichier .env à côté de static_drone.py est lu par le programme lui-même.

[Unit]
Description=Drone statique ia-agent (micros, caméra, haut-parleur)
Wants=pipewire.service pipewire-pulse.service
After=pipewire.service pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=%h/ia-agent/robotics/drones/static/onboard
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/ia-agent/robotics/drones/static/onboard/.venv/bin/python static_drone.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
