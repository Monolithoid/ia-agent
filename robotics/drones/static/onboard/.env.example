# Copier en .env (à côté de static_drone.py) puis adapter.
# Toutes les valeurs sauf ROSBRIDGE_URL/DOMAIN et ROSBRIDGE_TOKEN ont un défaut.

# ── Identité et connexion ────────────────────────────────────────────────────
DRONE_ID=static_01
# URL complète, ou laisser vide et renseigner DOMAIN (→ wss://rosbridge.$DOMAIN)
ROSBRIDGE_URL=wss://rosbridge.example.com
#DOMAIN=example.com
# Même jeton que sur le VPS (en-tête Authorization: Bearer, vérifié par rosbridge-proxy)
ROSBRIDGE_TOKEN=change-me

# ── Relais du NAO (ADR 006, voir nao-relay/README.md) ──────────────────────
# Utilisé seulement par le service nao-relay (Caddy), pas par static_drone.py.
# IP du NAO sur le câble Ethernet : seule adresse acceptée par le relais
NAO_IP=192.168.50.2
# rosbridge du VPS en https:// (même hôte que ROSBRIDGE_URL)
NAO_RELAY_UPSTREAM=https://rosbridge.example.com
#NAO_RELAY_PORT=9090

# ── Micros ───────────────────────────────────────────────────────────────────
# Entrée audio : nom (partiel) ou index (python3 -m sounddevice pour la liste).
# Vide = ReSpeaker s'il est branché, sinon entrée par défaut.
#AUDIO_INPUT_DEVICE=
SAMPLE_RATE=16000
# Canal enregistré et envoyé (0 = audio traité sur le ReSpeaker)
RECORD_CHANNEL=0
# Sans ReSpeaker, ≥ 2 micros : un nom:angle par canal d'entrée, dans l'ordre.
# Angle en degrés, 0 = axe de la caméra, positif = à droite.
#MICS=gauche:-60,droite:60
MICS=

# ── ReSpeaker USB Mic Array v2.0 ─────────────────────────────────────────────
# auto = utilisé s'il est détecté, 0 = ignoré, 1 = obligatoire
RESPEAKER=auto
# 1 si le haut-parleur est branché sur la sortie jack du ReSpeaker (annulation
# d'écho) : l'écoute reste alors active pendant que le drone parle.
RESPEAKER_AEC=0
# Décalage (degrés) ajouté à l'angle mesuré pour l'aligner sur la caméra
DOA_OFFSET=0
# 1 si l'angle du ReSpeaker tourne dans l'autre sens que la convention
DOA_INVERT=0

# ── Détection de parole (sans ReSpeaker) ─────────────────────────────────────
# Seuil RMS sur des échantillons 16 bits (0..32767) ; voir README pour le régler
RMS_THRESHOLD=500
# Silence (s) qui termine un enregistrement
SILENCE_S=0.8
MIN_SPEECH_S=0.3
MAX_RECORD_S=15
PRE_ROLL_S=0.3

# ── Haut-parleur ─────────────────────────────────────────────────────────────
# Commande qui lit un MP3 sur l'entrée standard
PLAYER_CMD=mpg123 -q -
#PLAYER_CMD=mpg123 -q -a hw:ArrayUAC10,0 -
PLAYBACK_TAIL_S=0.3

# ── Caméra ───────────────────────────────────────────────────────────────────
CAMERA_INDEX=0
# Champ de vision horizontal (degrés)
CAMERA_HFOV=66
CAMERA_WIDTH=320
CAMERA_HEIGHT=240
CAMERA_FPS=5
JPEG_QUALITY=70
MOTION_THRESHOLD=25
# Image publiée toutes les N s (0 = seulement sur demande)
IMAGE_INTERVAL=10

# ── Divers ───────────────────────────────────────────────────────────────────
STATUS_INTERVAL=30
RECONNECT_MAX_S=30
# Durée d'un bloc audio (ms)
BLOCK_MS=30
LOG_LEVEL=INFO
