<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motion_engine</name>
  <version>0.1.0</version>
  <description>
    Emotion-driven motion synthesis for NAO V5.
    Translates arousal/valence/vertical_split/lateral_bias payloads
    into biomechanically coherent joint commands at 20 Hz.
  </description>
  <maintainer email="dev@example.com">ia-agent</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
